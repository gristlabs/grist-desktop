+  /**
+   * Waits for every view to have the data it asked for. A cursor move in one widget makes the
+   * widgets linked to it re-query, and nothing in the page waits for that, so reading a linked
+   * widget straight after moving the cursor can return the rows it held before.
+   */
+  export async function waitForViewLoads(optTimeout: number = 5000) {
+    await waitForPendingOps("testNumPendingViewLoads", "views to load their data", optTimeout);
+  }
+
+  /**
+   * Waits for an open menu to hold the focus, which is when it starts handling keys. A menu takes
+   * focus on the tick after it is shown, so a key sent as soon as one appears can go elsewhere,
+   * and Escape in particular is then lost and the menu stays open.
+   */
+  export async function waitForMenuFocus(optTimeout: number = 1000) {
+    await driver.wait(async () => await driver.executeScript<boolean>(() => {
+      const menu = document.querySelector(".grist-floating-menu");
+      const active = document.activeElement;
+      return !!menu && !!active && (menu === active || menu.contains(active));
+    }), optTimeout, "the open menu did not take the focus");
+  }
+
+  /**
+   * Waits for a menu item's action to run. Items that let the menu close first run their action on
+   * the next tick, and waitForServer is not a substitute: a poll between the click and the tick
+   * sees nothing in flight, so a reload right after can lose what the action was going to do.
+   */
+  export async function waitForMenuAction(optTimeout: number = 2000) {
+    await waitForPendingOps("testNumPendingMenuActions", "a menu action to run", optTimeout);
+  }
