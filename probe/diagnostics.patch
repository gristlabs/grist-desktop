+  /**
+   * Waits for the tree to settle on the given page names, which is what hiding a table leads to.
+   *
+   * Changing the rules makes the app reload the document by itself. Refreshing the browser here
+   * instead would race that reload, and a browser that reconnects while the old connection is
+   * still up is given a fresh client id. Undo offers a client only the actions it made itself, so
+   * the page move above would then be beyond the reach of the undo at the end of this test, and
+   * would still be in place for every test below. The tree is emptied before it is rebuilt, so
+   * wait for the names it settles on rather than for a page to go.
+   */
+  async function waitForPages(expected: string[]) {
+    await driver.wait(async () => {
+      await driver.findWait(".test-treeview-container", 1000);
+      return isEqual(await gu.getPageNames(), expected);
+    }, 4000, `pages did not settle as ${expected.join(", ")}`);
+  }
+
+  /**
+   * Logs what the tree shows against what the document says it should show. They disagreeing
+   * would mean the tree never applied the saved state, rather than being slow to.
+   */
+  async function collapseProbe() {
+    const saved = async () => {
+      const pages: any = await api.getTable(doc.id, "_grist_Pages");
+      return (pages.options as string[]).filter(o => o && JSON.parse(o).collapsed).length;
+    };
+    const shown = async () => JSON.stringify({
+      names: await gu.getPageNames(),
+      collapsed: (await driver.findAll(".test-treeview-itemContainer.collapsed")).length,
+    });
+    const first = await shown();
+    const savedCount = await saved();
+    await driver.sleep(750);
+    console.log(`COLLAPSEPROBE document says ${savedCount} collapsed; tree at read ${first}; 750ms later ${
+      await shown()}`);
+  }
+
